rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Email Verifications (used during registration verification)
    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    // Download Requests (users can request, admin can approve/reject)
    match /download_requests/{requestId} {
      allow read, write: if true;
    }

    // Site Content & Editable Texts (all visitors can read, admins can edit)
    match /site_content/{contentId} {
      allow read, write: if true;
    }

    // GIS Projects & Ready Maps uploaded by admin (all visitors can read, admin can add/edit/delete)
    match /gis_projects/{projectId} {
      allow read, write: if true;
    }
  }
}
